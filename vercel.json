{
    "builds": [
        {
            "src": "front/package.json",
            "use": "@vercel/static-build",
            "config": {
                "distDir": "front/dist"
            }
        }
    ],
    "routes": [
        {
            "src": "/(.*)",
            "dest": "front/dist/index.html"
        }
    ]
}